# Copia este archivo a `.env.production` y rellena con los valores de producción.
# Asegúrate de pegarlos también en el dashboard de Vercel (Environment Variables -> Production)

NEXT_PUBLIC_APP_URL=https://gestor-de-vinedos.vercel.app
DEMO_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=RELLENAR_AQUI
NEXT_PUBLIC_SUPABASE_ANON_KEY=RELLENAR_AQUI
SUPABASE_SERVICE_KEY=RELLENAR_AQUI

# Polar
NEXT_PUBLIC_USE_POLAR=true
POLAR_SECRET_KEY=RELLENAR_AQUI
POLAR_WEBHOOK_SECRET=RELLENAR_AQUI
NEXT_PUBLIC_POLAR_PRODUCT_ID=RELLENAR_AQUI

# Stripe (fallback opcional)
STRIPE_SECRET_KEY=RELLENAR_AQUI
STRIPE_WEBHOOK_SECRET=RELLENAR_AQUI
NEXT_PUBLIC_STRIPE_PRICE_ID=RELLENAR_AQUI

# Otros
NEXT_PUBLIC_NODE_ENV=production
NOTIFICATIONS_FROM=RELLENAR_AQUI
